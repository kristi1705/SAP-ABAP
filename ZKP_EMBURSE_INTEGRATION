DATA go_emburse TYPE REF TO lcl_emburse.

CLASS lcl_emburse IMPLEMENTATION.

  METHOD add_logs.

    DATA(ls_log) = VALUE bal_s_log(
                   aluser     = sy-uname
                   alprog     = sy-repid
                   object     = 'ZEMBURSE'
                   subobject  = 'ZEMBURSE'
                   aldate_del = sy-datum + 180
                   del_before = abap_true
      ).

    IF mv_log_handle IS INITIAL.

      CALL FUNCTION 'BAL_LOG_CREATE'
        EXPORTING
          i_s_log      = ls_log
        IMPORTING
          e_log_handle = mv_log_handle
        EXCEPTIONS
          OTHERS       = 1.
      IF sy-subrc <> 0.
        MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
                WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
      ENDIF.

    ENDIF.

    DATA(ls_msg) = VALUE bal_s_msg(
       msgty     = sy-msgty
       msgid     = sy-msgid
       msgno     = sy-msgno
       msgv1     = sy-msgv1
       msgv2     = sy-msgv2
       msgv3     = sy-msgv3
       msgv4     = sy-msgv4
       probclass = 1
    ).

    GET TIME STAMP FIELD ls_msg-time_stmp.

    CALL FUNCTION 'BAL_LOG_MSG_ADD'
      EXPORTING
        i_log_handle     = mv_log_handle
        i_s_msg          = ls_msg
      EXCEPTIONS
        log_not_found    = 1
        msg_inconsistent = 2
        log_is_full      = 3
        OTHERS           = 4.
    IF sy-subrc <> 0.
      RETURN.
    ENDIF.

  ENDMETHOD.

  METHOD move_file_to_history.

    DATA lv_hist_msg(184) TYPE c.

    SPLIT p_drfl AT '/' INTO TABLE DATA(lt_file_path).

    READ TABLE lt_file_path INTO DATA(lv_file_path) INDEX lines( lt_file_path ).

    REPLACE '.csv' WITH space INTO lv_file_path.
    CONDENSE lv_file_path NO-GAPS.

    DATA(lv_hist_file) = |{ p_hist }/{ lv_file_path }_{ sy-datum }_{ sy-uzeit }_{ COND #( WHEN iv_error IS INITIAL THEN 'OK' ELSE 'KO' ) }.csv|.
    lv_hist_msg        = |{ lv_file_path }_{ sy-datum }_{ sy-uzeit }_{ COND #( WHEN iv_error IS INITIAL THEN 'OK' ELSE 'KO' ) }.csv|.

    OPEN DATASET lv_hist_file FOR OUTPUT IN TEXT MODE ENCODING UTF-8.
    IF sy-subrc <> 0.
      MESSAGE 'Directory not found' TYPE 'S' DISPLAY LIKE 'E'.
      RETURN.
    ENDIF.

    LOOP AT mt_csv_data ASSIGNING FIELD-SYMBOL(<lv_csv>).
      TRANSFER <lv_csv> TO lv_hist_file.
    ENDLOOP.
    CLOSE DATASET lv_hist_file.
    DELETE DATASET p_drfl.

    IF p_direct IS NOT INITIAL.
      MESSAGE i005(zemburse) WITH p_hist(50) p_hist+50(50) p_hist+100(50) p_hist+150(34) INTO DATA(lv_dummy).
      add_logs( ).
      MESSAGE i006(zemburse) WITH lv_hist_msg(50) lv_hist_msg+50(50) lv_hist_msg+100(50) lv_hist_msg+150(34) INTO lv_dummy.
      add_logs( ).
    ENDIF.

  ENDMETHOD.

  METHOD set_salv_columns.

    DATA: lo_col TYPE REF TO cl_salv_column_table.

    TRY.
        lo_col ?= io_columns->get_column( iv_col_def-fieldname ).

        lo_col->set_short_text( iv_col_def-short_text ).
        lo_col->set_medium_text( iv_col_def-medium_text ).
        lo_col->set_long_text( iv_col_def-long_text ).

        IF iv_col_def-force_long = abap_true.
          lo_col->set_fixed_header_text( 'L' ).
        ENDIF.

        IF iv_col_def-is_key = abap_true.
          lo_col->set_key( abap_true ).
        ENDIF.

        IF iv_col_def-is_hotspot = abap_true.
          lo_col->set_cell_type( if_salv_c_cell_type=>hotspot ).
        ENDIF.

        IF iv_col_def-is_icon = abap_true.
          lo_col->set_icon( abap_true ).
        ENDIF.

      CATCH cx_salv_not_found.
    ENDTRY.

  ENDMETHOD.

  METHOD ucomm_action.

    DATA lv_no_commit TYPE abap_bool.
    CLEAR mt_messages.

    CASE iv_ok_code.
      WHEN 'FC_POST'.
        post_doc( iv_test = abap_false ).
        display_msg( ).
        mo_salv->refresh( refresh_mode = if_salv_c_refresh=>full ).
      WHEN 'FC_BACK'.
        LEAVE TO SCREEN 0.
    ENDCASE.

  ENDMETHOD.

  METHOD get_csv_file.
    IF p_upl IS NOT INITIAL.
      get_local_csv( ).
    ELSE.
      get_directory_csv( ).
    ENDIF.
  ENDMETHOD.
  METHOD execute.

    CASE abap_true.
      WHEN p_direct.

        get_csv_file( ).
        DATA(lv_error) = post_doc( iv_test = abap_true ).

        IF lv_error IS INITIAL.
          CLEAR mt_messages.
          lv_error = post_doc( iv_test = abap_false ).
        ENDIF.

        IF p_dir IS NOT INITIAL AND p_hist IS NOT INITIAL.
          move_file_to_history( iv_error = lv_error ).
        ENDIF.

        display_msg( iv_no_dock = abap_true ).

      WHEN p_disply.

        get_csv_file( ).
        post_doc( iv_test = abap_true ).
        display_alv( ).

      WHEN p_logs.
        display_logs( ).
    ENDCASE.

  ENDMETHOD.                    "EXECUTE

  METHOD display_logs.

    DATA lt_log_header TYPE balhdr_t.
    DATA lt_log_handle TYPE bal_t_logh.

    SELECT * FROM balhdr
      USING ALL CLIENTS
            WHERE object EQ @p_lgobj
               AND subobject EQ @p_lgsbj
               AND aldate IN @s_aldate
               AND altime IN @s_altime
               AND aluser IN @s_aluser
             INTO TABLE @lt_log_header.
    IF sy-subrc <> 0.
      RETURN.
    ENDIF.

    "Load log files from database into memory
    CALL FUNCTION 'BAL_DB_LOAD'
      EXPORTING
        i_t_log_header = lt_log_header
      IMPORTING
        e_t_log_handle = lt_log_handle
      EXCEPTIONS
        OTHERS         = 0.

    CALL FUNCTION 'BAL_DSP_LOG_DISPLAY'
      EXPORTING
        i_t_log_handle = lt_log_handle
        i_amodal       = space
      EXCEPTIONS
        OTHERS         = 0.

    LOOP AT lt_log_handle ASSIGNING FIELD-SYMBOL(<lv_log_hdl>).
      CALL FUNCTION 'BAL_LOG_REFRESH'
        EXPORTING
          i_log_handle = <lv_log_hdl>
        EXCEPTIONS
          OTHERS       = 0.
    ENDLOOP.

  ENDMETHOD.

  METHOD get_local_csv.

    DATA lv_upfl TYPE string.

    IF p_upfl IS INITIAL.
      RETURN.
    ENDIF.

    lv_upfl = p_upfl.

    cl_gui_frontend_services=>gui_upload(
      EXPORTING
        filename                = lv_upfl
        filetype                = 'ASC'
      CHANGING
        data_tab                = mt_csv_data
      EXCEPTIONS
        file_open_error         = 1                " File does not exist and cannot be opened
        file_read_error         = 2                " Error when reading file
        no_batch                = 3                " Cannot execute front-end function in background
        gui_refuse_filetransfer = 4                " Incorrect front end or error on front end
        invalid_type            = 5                " Incorrect parameter FILETYPE
        no_authority            = 6                " No upload authorization
        unknown_error           = 7                " Unknown error
        bad_data_format         = 8                " Cannot Interpret Data in File
        header_not_allowed      = 9                " Invalid header
        separator_not_allowed   = 10               " Invalid separator
        header_too_long         = 11               " Header information currently restricted to 1023 bytes
        unknown_dp_error        = 12               " Error when calling data provider
        access_denied           = 13               " Access to file denied.
        dp_out_of_memory        = 14               " Not enough memory in data provider
        disk_full               = 15               " Storage medium is full.
        dp_timeout              = 16               " Data provider timeout
        not_supported_by_gui    = 17               " GUI does not support this
        error_no_gui            = 18               " GUI not available
        OTHERS                  = 19
    ).

    IF sy-subrc <> 0.
      MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
              WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
    ENDIF.

    IF p_direct IS NOT INITIAL.
      MESSAGE i003(zemburse) WITH p_upfl(50) p_upfl+50(50) p_upfl+100(50) p_upfl+150(34) INTO DATA(lv_dummy).
      add_logs( ).
    ENDIF.

    csv_to_table( ).
  ENDMETHOD.

  METHOD get_directory_csv.

    DATA lv_csv_data TYPE string.

    OPEN DATASET p_drfl FOR INPUT IN TEXT MODE ENCODING UTF-8.
    IF sy-subrc <> 0.
      MESSAGE 'File not found' TYPE 'S' DISPLAY LIKE 'E'.
      RETURN.
    ENDIF.

    DO.
      READ DATASET p_drfl INTO lv_csv_data.
      IF sy-subrc <> 0.
        EXIT.
      ENDIF.
      APPEND lv_csv_data TO mt_csv_data.
    ENDDO.

    CLOSE DATASET p_drfl.

    IF p_direct IS NOT INITIAL.
      MESSAGE i004(zemburse) WITH p_drfl(50) p_drfl+50(50) p_drfl+100(50) p_drfl+150(34) INTO DATA(lv_dummy).
      add_logs( ).
    ENDIF.

    csv_to_table( ).

  ENDMETHOD.
  METHOD csv_to_table.

    TYPES: BEGIN OF ty_split,
             id                   TYPE string,
             company_code         TYPE string,
             posting_date         TYPE string,
             accounting_date      TYPE string,
             reason               TYPE string,
             sub_ledger           TYPE string,
             doc_date             TYPE string,
             doc_number           TYPE string,
             account              TYPE string,
             currency             TYPE string,
             debit                TYPE string,
             credit               TYPE string,
             exchange_rate        TYPE string,
             line_description     TYPE string,
             vat                  TYPE string,
             vat_perc             TYPE string,
             due_date             TYPE string,
             subject_id           TYPE string,
             contract_id          TYPE string,
             cost_id              TYPE string,
             pmt_number           TYPE string,
             asset_id             TYPE string,
             payment_condition    TYPE string,
             companys_bank_id     TYPE string,
             ref_accounting_entry TYPE string,
             benef_bank_code      TYPE string,
             benef_bank_branch    TYPE string,
             benef_bank_account   TYPE string,
             benef_bank_iban      TYPE string,
             notes                TYPE string,
             autoreverse_due_date TYPE string,
             exec_type            TYPE string,
             exec_subject_type    TYPE string,
             exec_subject_id      TYPE string,
           END OF ty_split.

    DATA: ls_split    TYPE ty_split,
          lv_prog_nr  TYPE string,
          lv_skip_itm TYPE i VALUE 0,
          lv_hkont    TYPE c LENGTH 10,
          lv_spaces   TYPE string VALUE '    '.

    LOOP AT mt_csv_data ASSIGNING FIELD-SYMBOL(<lv_csv_data>) FROM 2.

      DATA(lv_excel_line) = sy-tabix.

      SPLIT <lv_csv_data> AT ';' INTO
          ls_split-id
          ls_split-company_code
          ls_split-posting_date
          ls_split-accounting_date
          ls_split-reason
          ls_split-sub_ledger
          ls_split-doc_date
          ls_split-doc_number
          ls_split-account
          ls_split-currency
          ls_split-debit
          ls_split-credit
          ls_split-exchange_rate
          ls_split-line_description
          ls_split-vat
          ls_split-vat_perc
          ls_split-due_date
          ls_split-subject_id
          ls_split-contract_id
          ls_split-cost_id
          ls_split-pmt_number
          ls_split-asset_id
          ls_split-payment_condition
          ls_split-companys_bank_id
          ls_split-ref_accounting_entry
          ls_split-benef_bank_code
          ls_split-benef_bank_branch
          ls_split-benef_bank_account
          ls_split-benef_bank_iban
          ls_split-notes
          ls_split-autoreverse_due_date
          ls_split-exec_type
          ls_split-exec_subject_type
          ls_split-exec_subject_id   .

      APPEND INITIAL LINE TO mt_alv_data ASSIGNING FIELD-SYMBOL(<ls_alv_data>).

      <ls_alv_data> = CORRESPONDING #( ls_split ).

      <ls_alv_data>-posting_date    = |{ ls_split-posting_date+6(4) }{ ls_split-posting_date+3(2) }{ ls_split-posting_date(2) }|.
      <ls_alv_data>-accounting_date = |{ ls_split-accounting_date+6(4) }{ ls_split-accounting_date+3(2) }{ ls_split-accounting_date(2) }|.
      <ls_alv_data>-doc_date        = |{ ls_split-doc_date+6(4) }{ ls_split-doc_date+3(2) }{ ls_split-doc_date(2) }|.
      <ls_alv_data>-due_date        = |{ ls_split-due_date+6(4) }{ ls_split-due_date+3(2) }{ ls_split-due_date(2) }|.
      <ls_alv_data>-bukrs           = ls_split-company_code.

      READ TABLE mt_zterm_buff  ASSIGNING FIELD-SYMBOL(<ls_zterm_buff>) WITH TABLE KEY ext_value = <ls_alv_data>-payment_condition.
      IF sy-subrc <> 0.
        INSERT VALUE #( ext_value = <ls_alv_data>-payment_condition ) INTO TABLE mt_zterm_buff ASSIGNING <ls_zterm_buff>.

        SELECT SINGLE sap_value
          FROM zemburse_zterms
          WHERE ext_value = @<ls_alv_data>-payment_condition
          INTO @<ls_zterm_buff>-sap_value.
      ENDIF.

      <ls_alv_data>-zterm = <ls_zterm_buff>-sap_value.

      fill_bapi_table( is_alv_data = <ls_alv_data> ).

    ENDLOOP.

    SORT mt_alv_data BY id.

  ENDMETHOD.

  METHOD fill_bapi_table.

    READ TABLE mt_post_bapi ASSIGNING FIELD-SYMBOL(<ls_post_bapi>) WITH TABLE KEY id = is_alv_data-id.
    IF sy-subrc <> 0.

      INSERT VALUE #(
        id     = is_alv_data-id
        header = VALUE #(
               username     = sy-uname
               comp_code    = is_alv_data-bukrs
               doc_date     = is_alv_data-doc_date
               pstng_date   = is_alv_data-posting_date
               ref_doc_no   = is_alv_data-doc_number
        )
      ) INTO TABLE mt_post_bapi ASSIGNING <ls_post_bapi>.

    ENDIF.


    IF is_alv_data-debit IS NOT INITIAL.

      APPEND VALUE bapiacgl09(  itemno_acc = lines( <ls_post_bapi>-glacc ) + 1
                                gl_account = is_alv_data-account
                                comp_code  = is_alv_data-bukrs
                                item_text  = is_alv_data-line_description
                                tax_code   = is_alv_data-vat
      ) TO <ls_post_bapi>-glacc.

    ELSE.

      APPEND VALUE bapiacap09(  itemno_acc = lines( <ls_post_bapi>-glacc ) + 1
                                comp_code  = is_alv_data-bukrs
                                item_text  = is_alv_data-line_description
                                tax_code   = is_alv_data-vat
                                pmnttrms   = is_alv_data-zterm
      ) TO <ls_post_bapi>-pyacc.

    ENDIF.

    APPEND VALUE bapiaccr09(
                     itemno_acc = lines( <ls_post_bapi>-currc ) + 1
                     curr_type  = '00'
                     currency   = is_alv_data-currency

                     exch_rate  = is_alv_data-exchange_rate
                     amt_doccur = COND #( WHEN is_alv_data-credit IS NOT INITIAL THEN is_alv_data-credit ELSE ( is_alv_data-debit * -1 ) )
    ) TO <ls_post_bapi>-currc.

  ENDMETHOD.

  METHOD display_alv.

    DATA: lo_columns TYPE REF TO cl_salv_columns,
          lo_column  TYPE REF TO cl_salv_column_list.

    CREATE OBJECT mo_cust_cont
      EXPORTING
        container_name              = 'CONTAINER'
      EXCEPTIONS
        cntl_error                  = 1
        cntl_system_error           = 2
        create_error                = 3
        lifetime_error              = 4
        lifetime_dynpro_dynpro_link = 5
        OTHERS                      = 6.
    IF sy-subrc <> 0.
      MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
        WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
    ENDIF.

    TRY.
        cl_salv_table=>factory(
          EXPORTING
            r_container  = mo_cust_cont
          IMPORTING
            r_salv_table = mo_salv
          CHANGING
            t_table      = mt_alv_data
        ).
      CATCH cx_salv_msg INTO DATA(lx_msg).
        RETURN.
    ENDTRY.

    DATA(lo_funct) = mo_salv->get_functions( ).
    lo_funct->set_all( abap_true ).

    TRY.
        lo_columns = mo_salv->get_columns( ).
        lo_columns->set_optimize( ).

        mt_fcat = VALUE #(
        force_long = abap_true
    ( fieldname = 'STATUS'               long_text = 'Status'                   )
    ( fieldname = 'ID'                   long_text = 'ID'                  is_key  = abap_true                         )
    ( fieldname = 'BELNR'                long_text = 'Document Number'     is_key  = abap_true  is_hotspot = abap_true )
    ( fieldname = 'BUKRS'                long_text = 'Company Code'        is_key  = abap_true                         )
    ( fieldname = 'BLART'                long_text = 'Document Type'            )
    ( fieldname = 'POSTING_DATE'         long_text = 'Post. Date'               )
    ( fieldname = 'ACCOUNTING_DATE'      long_text = 'Acct. Date'               )
    ( fieldname = 'REASON'               long_text = 'Reason'                   )
    ( fieldname = 'SUB_LEDGER'           long_text = 'Sub-Ledger'               )
    ( fieldname = 'DOC_DATE'             long_text = 'Document Date'            )
    ( fieldname = 'DOC_NUMBER'           long_text = 'Reference Document'       )
    ( fieldname = 'ACCOUNT'              long_text = 'Account'                  )
    ( fieldname = 'CURRENCY'             long_text = 'Currency'                 )
    ( fieldname = 'DEBIT'                long_text = 'Debit'                    )
    ( fieldname = 'CREDIT'               long_text = 'Credit'                   )
    ( fieldname = 'EXCHANGE_RATE'        long_text = 'Exchange Rate'            )
    ( fieldname = 'LINE_DESCRIPTION'     long_text = 'Line Description'         )
    ( fieldname = 'VAT'                  long_text = 'VAT Code'                 )
    ( fieldname = 'VAT_PERC'             long_text = 'VAT'                      )
    ( fieldname = 'DUE_DATE'             long_text = 'Due Date'                 )
    ( fieldname = 'SUBJECT_ID'           long_text = 'Subject ID'               )
    ( fieldname = 'CONTRACT_ID'          long_text = 'Contract'                 )
    ( fieldname = 'COST_ID'              long_text = 'Cost Center'              )
    ( fieldname = 'PMT_NUMBER'           long_text = 'Payment Number'           )
    ( fieldname = 'ASSET_ID'             long_text = 'Asset ID'                 )
    ( fieldname = 'PAYMENT_CONDITION'    long_text = 'Payment Condition'        )
    ( fieldname = 'COMPANYS_BANK_ID'     long_text = 'Company Bank ID'          )
    ( fieldname = 'REF_ACCOUNTING_ENTRY' long_text = 'Reference Entry'          )
    ( fieldname = 'BENEF_BANK_CODE'      long_text = 'Beneficiary Bank Code'    )
    ( fieldname = 'BENEF_BANK_BRANCH'    long_text = 'Beneficiary Bank Branch'  )
    ( fieldname = 'BENEF_BANK_ACCOUNT'   long_text = 'Beneficiary Bank Account' )
    ( fieldname = 'BENEF_BANK_IBAN'      long_text = 'Beneficiary IBAN'         )
    ( fieldname = 'NOTES'                long_text = 'Notes'                    )
    ( fieldname = 'AUTOREVERSE_DUE_DATE' long_text = 'Auto Reverse Due Date'    )
    ( fieldname = 'EXEC_TYPE'            long_text = 'Execution Type'           )
    ( fieldname = 'EXEC_SUBJECT_TYPE'    long_text = 'Exec. Subject Type'       )
    ( fieldname = 'EXEC_SUBJECT_ID'      long_text = 'Execution Subject ID'     )
  ).

        LOOP AT mt_fcat INTO DATA(ls_fcat).
          set_salv_columns( iv_col_def = ls_fcat io_columns = lo_columns ).
        ENDLOOP.

        DATA(lo_cols) = CAST cl_salv_columns_table( lo_columns ).
        lo_cols->set_exception_column( value = 'STATUS' ).

        lo_columns->set_column_position(
          columnname = 'STATUS'
          position   = 1 ).

        lo_columns->set_column_position(
          columnname = 'ID'
          position   = 2 ).

        lo_columns->set_column_position(
          columnname = 'BELNR'
          position   = 3 ).

        lo_columns->set_column_position(
          columnname = 'BUKRS'
          position   = 4 ).


        DATA(lo_sorts) = mo_salv->get_sorts( ).
        DATA(lo_sort) =
          lo_sorts->add_sort(
          EXPORTING
            columnname = 'STATUS'
            subtotal   = if_salv_c_bool_sap=>true
        ).
        lo_sorts->add_sort(
          EXPORTING
            columnname = 'ID'
            subtotal   = if_salv_c_bool_sap=>true
        ).

      CATCH cx_salv_not_found.
      CATCH cx_salv_data_error.
      CATCH cx_salv_existing.
    ENDTRY.

    SET HANDLER on_link_click
            FOR mo_salv->get_event( ).

    mo_salv->display( ).
    display_msg( ).
    CALL SCREEN 0001.

  ENDMETHOD.

  METHOD on_link_click .

    READ TABLE mt_alv_data ASSIGNING FIELD-SYMBOL(<ls_data>) INDEX row.
    IF sy-subrc <> 0.
      RETURN.
    ENDIF.

    CASE column.
      WHEN 'BELNR'.
        view_belnr(
          EXPORTING
            iv_belnr = <ls_data>-belnr
            iv_gjahr = <ls_data>-gjahr
            iv_bukrs = <ls_data>-bukrs
        ).

    ENDCASE.

  ENDMETHOD.

  METHOD post_doc.

    DATA: lv_obj_key TYPE bapiache09-obj_key,
          lv_status  TYPE char1.

    LOOP AT mt_post_bapi ASSIGNING FIELD-SYMBOL(<ls_post>).

      CLEAR lv_obj_key.

      call_bapi(
        EXPORTING
          iv_test       = iv_test
          iv_log_handle = mv_log_handle
          is_post       = <ls_post>
        IMPORTING
          ev_obj_key    = lv_obj_key
          ev_status     = lv_status
      ).

      READ TABLE mt_alv_data TRANSPORTING NO FIELDS WITH KEY id  = <ls_post>-id BINARY SEARCH.
      IF sy-subrc = 0.
        LOOP AT mt_alv_data ASSIGNING FIELD-SYMBOL(<ls_alv_data>) FROM sy-tabix.
          IF <ls_alv_data>-id <> <ls_post>-id.
            EXIT.
          ENDIF.

          <ls_alv_data>-status = lv_status.

          IF iv_test IS NOT INITIAL.
            <ls_alv_data>-belnr  = lv_obj_key(10).
            <ls_alv_data>-gjahr  = lv_obj_key+14(4).
          ENDIF.
        ENDLOOP.
      ENDIF.

      IF lv_status = 1.
        rv_error = abap_true.
      ENDIF.

      IF rv_error IS NOT INITIAL.
        CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
        CONTINUE.
      ENDIF.

      IF iv_test IS INITIAL.
        CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
          EXPORTING
            wait = 'X'.
      ENDIF.

    ENDLOOP.

    IF iv_test IS INITIAL.
      MESSAGE 'Data saved successfully!'(004) TYPE 'S'.
    ELSE.
      MESSAGE 'Simulation concluded. Please, check the messages!'(005) TYPE 'S'.
    ENDIF.

  ENDMETHOD.

  METHOD call_bapi.

    DATA lt_return TYPE TABLE OF bapiret2.

    CLEAR: ev_status, ev_obj_key.

    DATA(lt_glacc) = is_post-glacc.
    DATA(lt_pyacc) = is_post-pyacc.
    DATA(lt_currc) = is_post-currc.

    IF iv_test = abap_true.

      CALL FUNCTION 'BAPI_ACC_DOCUMENT_CHECK'
        EXPORTING
          documentheader = is_post-header
        TABLES
          accountgl      = lt_glacc
          accountpayable = lt_pyacc
          currencyamount = lt_currc
          return         = lt_return.

    ELSE.

      CALL FUNCTION 'BAPI_ACC_DOCUMENT_POST'
        EXPORTING
          documentheader = is_post-header
        IMPORTING
          obj_key        = ev_obj_key
        TABLES
          accountgl      = lt_glacc
          accountpayable = lt_pyacc
          currencyamount = lt_currc
          return         = lt_return.
    ENDIF.

    SORT lt_return BY message.
    DELETE ADJACENT DUPLICATES FROM lt_return COMPARING message.
    SORT lt_return BY row.

    DATA(lv_msg_nr) = 0.
    LOOP AT lt_return ASSIGNING FIELD-SYMBOL(<ls_return>).
      lv_msg_nr += 1.
      APPEND VALUE #( id      = is_post-id
                      bukrs   = is_post-header-comp_code
                      status  = SWITCH #(
                      <ls_return>-type
                        WHEN 'E' THEN 1
                        WHEN 'W' THEN 2
                        WHEN 'S' THEN 3
                         )
                      msg_no  = lv_msg_nr
                      message = <ls_return>-message
                      belnr   = COND #( WHEN ev_obj_key <> '$' THEN ev_obj_key(10) )
                      gjahr   = COND #( WHEN ev_obj_key <> '$' THEN ev_obj_key+10(4) )
                       ) TO mt_messages.

      IF iv_test IS INITIAL.
        MESSAGE e002(zemburse) WITH is_post-id <ls_return>-message(50) <ls_return>-message+50(50) INTO DATA(lv_dummy).
        add_logs( ).
      ENDIF.

      IF <ls_return>-type CA 'EAX'.
        ev_status = 1.
      ENDIF.

    ENDLOOP.

    IF ev_status IS INITIAL.
      ev_status = 3.
    ENDIF.

  ENDMETHOD.

  METHOD f4_directory_file.

    CALL FUNCTION '/SAPDMC/LSM_F4_SERVER_FILE'
      IMPORTING
        serverfile       = p_drfl
      EXCEPTIONS
        canceled_by_user = 1
        OTHERS           = 2.
    IF sy-subrc <> 0.
      RETURN.
    ENDIF.

  ENDMETHOD.

  METHOD f4_local_file.

    DATA: lt_filetable TYPE filetable,
          lv_rc        TYPE i.

    cl_gui_frontend_services=>file_open_dialog(
      EXPORTING
        default_filename        = '*.CSV'
        file_filter             = '*.CSV'
        multiselection          = abap_false
      CHANGING
        file_table              = lt_filetable
        rc                      = lv_rc
      EXCEPTIONS
        file_open_dialog_failed = 1
        cntl_error              = 2
        error_no_gui            = 3
        not_supported_by_gui    = 4
        OTHERS                  = 5 ).

    IF sy-subrc = 0.
      READ TABLE lt_filetable INDEX 1 INTO p_upfl.
    ENDIF.

  ENDMETHOD.

  METHOD display_msg.

    DATA: lo_functions  TYPE REF TO cl_salv_functions_list,
          lo_events     TYPE REF TO cl_salv_events_table,
          lt_log_handle TYPE bal_t_logh.

    APPEND mv_log_handle TO lt_log_handle.

    CALL FUNCTION 'BAL_DB_SAVE'
      EXPORTING
        i_save_all       = 'X'
        i_t_log_handle   = lt_log_handle
      EXCEPTIONS
        log_not_found    = 1
        save_not_allowed = 2
        numbering_error  = 3
        OTHERS           = 4.
    IF sy-subrc <> 0.
      MESSAGE 'Cound not save log' TYPE 'S' DISPLAY LIKE 'E'.
    ENDIF.

    IF iv_no_dock IS INITIAL.

      IF mo_salv_msg IS NOT INITIAL.
        mo_dock_msg->set_visible(
          EXPORTING
            visible           = abap_true
          EXCEPTIONS
            cntl_error        = 1
            cntl_system_error = 2
            OTHERS            = 3
        ).
        IF sy-subrc <> 0.
          MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
            WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
        ENDIF.
        adjust_cols_msg( iv_no_dock = iv_no_dock ).
        mo_salv_msg->refresh( ).
        RETURN.
      ENDIF.

      CREATE OBJECT mo_dock_msg
        EXPORTING
          repid = sy-repid
          dynnr = '0001'
          ratio = 50
          side  = cl_gui_docking_container=>dock_at_bottom.

      TRY.
          cl_salv_table=>factory(
            EXPORTING
              r_container  = mo_dock_msg
            IMPORTING
              r_salv_table = mo_salv_msg
            CHANGING
              t_table      = mt_messages ).
        CATCH cx_salv_msg INTO DATA(lx_msg).
          MESSAGE lx_msg->get_longtext( ) TYPE 'S' DISPLAY LIKE 'E'.
          LEAVE LIST-PROCESSING.
      ENDTRY.

      lo_functions = mo_salv_msg->get_functions( ).
      lo_functions->set_all( 'X' ).

      TRY.
          DATA(lv_icon) = icon_close.
          lo_functions->add_function(
            EXPORTING
              name     = 'FC_CLOSE'
              icon     = CONV #( lv_icon )
              tooltip  = 'Close'
              position = if_salv_c_function_position=>right_of_salv_functions
          ).
        CATCH cx_salv_existing.
        CATCH cx_salv_wrong_call.
      ENDTRY.

      lo_events = mo_salv_msg->get_event( ).
      SET HANDLER handle_logs_ucomm
                  on_msg_link_click
             FOR lo_events.

    ELSE.

      TRY.
          cl_salv_table=>factory(
            EXPORTING
              list_display = sy-batch " ALV Displayed in List Mode
            IMPORTING
              r_salv_table = mo_salv_msg
            CHANGING
              t_table      = mt_messages ).
        CATCH cx_salv_msg INTO lx_msg.
          MESSAGE lx_msg->get_longtext( ) TYPE 'S' DISPLAY LIKE 'E'.
          LEAVE LIST-PROCESSING.
      ENDTRY.

      mo_salv_msg->get_functions( )->set_all( 'X' ).

    ENDIF.

    adjust_cols_msg( iv_no_dock = iv_no_dock ).
    mo_salv_msg->display( ).

  ENDMETHOD.

  METHOD handle_logs_ucomm.
    CASE e_salv_function.
      WHEN 'FC_CLOSE'.

        mo_dock_msg->set_visible(
          EXPORTING
            visible           = abap_false                 " Visible
          EXCEPTIONS
            cntl_error        = 1                " CNTL_ERROR
            cntl_system_error = 2                " CNTL_SYSTEM_ERROR
            OTHERS            = 3
        ).
        IF sy-subrc <> 0.
          MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
            WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
        ENDIF.

    ENDCASE.
  ENDMETHOD.

  METHOD on_msg_link_click.
    READ TABLE mt_messages ASSIGNING FIELD-SYMBOL(<ls_msg>) INDEX row.
    IF sy-subrc <> 0.
      RETURN.
    ENDIF.

    CASE column.
      WHEN 'BELNR'.

        view_belnr(
          EXPORTING
            iv_belnr = <ls_msg>-belnr
            iv_gjahr = <ls_msg>-gjahr
            iv_bukrs = <ls_msg>-bukrs
        ).
    ENDCASE.

  ENDMETHOD.

  METHOD view_belnr.

    IF iv_belnr IS INITIAL.
      RETURN.
    ENDIF.

    DATA(lv_gjahr) = iv_gjahr.
    DATA(lv_bukrs) = iv_bukrs.

    SET PARAMETER ID 'GJR' FIELD lv_gjahr.
    SET PARAMETER ID 'BUK' FIELD lv_bukrs.
    SET PARAMETER ID 'BLN' FIELD iv_belnr.

    CALL TRANSACTION 'FB03' WITH AUTHORITY-CHECK AND SKIP FIRST SCREEN.

  ENDMETHOD.

  METHOD adjust_cols_msg.

    DATA: lo_column TYPE REF TO cl_salv_column_table,
          lo_cols   TYPE REF TO cl_salv_columns.

    lo_cols = mo_salv_msg->get_columns( ).
    lo_cols->set_optimize( abap_true ).

    TRY.
        " STATUS (ICON)
        lo_column ?= lo_cols->get_column( 'STATUS' ).
        lo_column->set_short_text( 'Status' ).
        lo_column->set_medium_text( 'Status' ).
        lo_column->set_long_text( 'Status' ).
        DATA(lo_columns) = CAST cl_salv_columns_table( lo_cols ).
        lo_columns->set_exception_column( value = 'STATUS' ).

        " MSG_NO
        lo_column ?= lo_cols->get_column( 'MSG_NO' ).
        lo_column->set_key( abap_true ).

        " ID
        lo_column ?= lo_cols->get_column( 'ID' ).
        lo_column->set_short_text( 'ID' ).
        lo_column->set_medium_text( 'ID' ).
        lo_column->set_long_text( 'ID' ).
        lo_column->set_key( abap_true ).

        " BELNR
        lo_column ?= lo_cols->get_column( 'BELNR' ).
        lo_column->set_cell_type( if_salv_c_cell_type=>hotspot ).


        DATA(lo_sorts) = mo_salv_msg->get_sorts( ).

        lo_sorts->add_sort(
          EXPORTING
            columnname = 'STATUS'
        ).
        lo_sorts->add_sort(
          EXPORTING
            columnname = 'ID'
        ).

        lo_sorts->add_sort(
          EXPORTING
            columnname = 'MSG_NO'
        ).

      CATCH cx_salv_not_found.
      CATCH cx_salv_data_error.
      CATCH cx_salv_existing.

    ENDTRY.

  ENDMETHOD.

ENDCLASS.

AT SELECTION-SCREEN ON VALUE-REQUEST FOR p_drfl.
  lcl_emburse=>f4_directory_file( ).

AT SELECTION-SCREEN ON VALUE-REQUEST FOR p_upfl.
  lcl_emburse=>f4_local_file( ).

AT SELECTION-SCREEN OUTPUT.
  LOOP AT SCREEN.
    CASE abap_true.
      WHEN p_logs.
        CASE screen-group1.
          WHEN 'CLG' OR 'DSP'.
            screen-active = 1.
          WHEN OTHERS.
            IF screen-group3 = 'BLK'.
              screen-active = 1.
            ELSE.
              screen-active = 0.
            ENDIF.
        ENDCASE.
        IF screen-name = 'P_LGOBJ' OR screen-name = 'P_LGSBJ'.
          screen-input = 0.
        ENDIF.
      WHEN p_disply OR p_direct.
        IF screen-group1 = 'CLG'.
          screen-active = 0.
        ENDIF.
    ENDCASE.
    MODIFY SCREEN.
  ENDLOOP.

