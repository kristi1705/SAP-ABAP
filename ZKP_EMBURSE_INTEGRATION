             exchange_rate        TYPE bkpf-kursf,
             line_description     TYPE bseg-sgtxt,
             vat                  TYPE bseg-mwskz,
             vat_perc             TYPE text50,
             due_date             TYPE text50,
             subject_id           TYPE bseg-lifnr,
             contract_id          TYPE text50,
             cost_id              TYPE bseg-kostl,
