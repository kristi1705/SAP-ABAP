CLASS lcl_xml_display DEFINITION.

  PUBLIC SECTION.

    METHODS:
      get_file
        RETURNING VALUE(rv_file) TYPE string,

      upload_xml
        IMPORTING iv_path           TYPE string
        RETURNING VALUE(rv_xstring) TYPE xstring,

      find_binary_object
        IMPORTING iv_xstring TYPE xstring,

      get_header_fields
        IMPORTING iv_xstring TYPE xstring,

      display_pdf.

  PRIVATE SECTION.

    DATA mv_content   TYPE string.

ENDCLASS.

CLASS lcl_xml_display IMPLEMENTATION.

  METHOD get_file.

    DATA: lt_files TYPE filetable,
          lv_rc    TYPE i.

    cl_gui_frontend_services=>file_open_dialog(
      EXPORTING
        window_title            = 'Select XML File'      " Title Of File Open Dialog
        default_filename        = '*.xml'                " Default File Name
        file_filter             = '*.xml'                " File Extension Filter String
      CHANGING
        file_table              = lt_files               " Table Holding Selected Files
        rc                      = lv_rc                  " Return Code, Number of Files or -1 If Error Occurred
      EXCEPTIONS
        file_open_dialog_failed = 1                " "Open File" dialog failed
        cntl_error              = 2                " Control error
        error_no_gui            = 3                " No GUI available
        not_supported_by_gui    = 4                " GUI does not support this
        OTHERS                  = 5
    ).
    IF sy-subrc <> 0.
      MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
        WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
    ENDIF.

    rv_file = COND #(
                      WHEN lv_rc = 1
                      THEN VALUE #( lt_files[ 1 ]-filename OPTIONAL )
                      ELSE '').

  ENDMETHOD.

  METHOD upload_xml.

    DATA: lt_raw    TYPE solix_tab,
          lv_length TYPE i.

    cl_gui_frontend_services=>gui_upload(
      EXPORTING
        filename                = iv_path          " Name of file
        filetype                = 'BIN'            " File Type (ASCII, Binary)
      CHANGING
        data_tab                = lt_raw           " Transfer table for file contents
      EXCEPTIONS
        file_open_error         = 1                " File does not exist and cannot be opened
        file_read_error         = 2                " Error when reading file
        no_batch                = 3                " Front-End Function Cannot Be Executed in Backgrnd
        gui_refuse_filetransfer = 4                " Incorrect front end or error on front end
        invalid_type            = 5                " Incorrect parameter FILETYPE
        no_authority            = 6                " No Upload Authorization
        unknown_error           = 7                " Unknown error
        bad_data_format         = 8                " Cannot Interpret Data in File
        header_not_allowed      = 9                " Invalid header
        separator_not_allowed   = 10               " Invalid separator
        header_too_long         = 11               " Header information currently restricted to 1023 bytes
        unknown_dp_error        = 12               " Error when calling data provider
        access_denied           = 13               " Access to File Denied
        dp_out_of_memory        = 14               " Not Enough Memory in DataProvider
        disk_full               = 15               " Storage Medium full
        dp_timeout              = 16               " Timeout of DataProvider
        not_supported_by_gui    = 17               " GUI does not support this
        error_no_gui            = 18               " GUI not available
        OTHERS                  = 19
    ).
    IF sy-subrc <> 0.
      MESSAGE 'Error uploading XML file' TYPE 'E'.
    ENDIF.

    lv_length = lines( lt_raw ) * 255.

    CALL FUNCTION 'SCMS_BINARY_TO_XSTRING'
      EXPORTING
        input_length = lv_length
      IMPORTING
        buffer       = rv_xstring
      TABLES
        binary_tab   = lt_raw
      EXCEPTIONS
        failed       = 1
        OTHERS       = 2.
    IF sy-subrc <> 0.
      MESSAGE 'Error converting binary to xstring' TYPE 'E'.
    ENDIF.

  ENDMETHOD.

