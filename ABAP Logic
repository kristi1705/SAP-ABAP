  METHOD display_pdf.

    DATA: lo_container TYPE REF TO cl_gui_custom_container,
          lo_viewer    TYPE REF TO cl_gui_html_viewer,
          lt_pdf_tab   TYPE solix_tab,
          lv_size      TYPE i,
          lv_url       TYPE char255,
          lv_clean     TYPE string,
          lv_xstring   TYPE xstring,
          lv_html_xstr TYPE xstring.

    CALL FUNCTION 'SCMS_BASE64_DECODE_STR'
      EXPORTING
        input  = mv_content
      IMPORTING
        output = lv_xstring
      EXCEPTIONS
        failed = 1
        OTHERS = 2.
    IF sy-subrc <> 0.
      MESSAGE 'Based64 decoding failed' TYPE 'E'.
    ENDIF.

    CALL FUNCTION 'SCMS_XSTRING_TO_BINARY'
      EXPORTING
        buffer        = lv_xstring
      IMPORTING
        output_length = lv_size
      TABLES
        binary_tab    = lt_pdf_tab.
    IF sy-subrc <> 0.
      MESSAGE 'Error preparing PDF binary' TYPE 'E'.
    ENDIF.

    CREATE OBJECT lo_container
      EXPORTING
        container_name              = 'PDF'                 " Name of the Screen CustCtrl Name to Link Container To
      EXCEPTIONS
        cntl_error                  = 1                " CNTL_ERROR
        cntl_system_error           = 2                " CNTL_SYSTEM_ERROR
        create_error                = 3                " CREATE_ERROR
        lifetime_error              = 4                " LIFETIME_ERROR
        lifetime_dynpro_dynpro_link = 5                " LIFETIME_DYNPRO_DYNPRO_LINK
        OTHERS                      = 6.
    IF sy-subrc <> 0.
      MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
        WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
    ENDIF.

    lo_viewer = NEW cl_gui_html_viewer(
      parent = lo_container                 " Container
    ).

    lo_viewer->load_data(
      EXPORTING
        type                   = 'application'           " Type of a MIME Object
        subtype                = 'pdf'           " Subtype of a MIME Object
      IMPORTING
        assigned_url           = lv_url                 " URL
      CHANGING
        data_table             = lt_pdf_tab                 " data table
      EXCEPTIONS
        dp_invalid_parameter   = 1                " invalid parameter in a DP call
        dp_error_general       = 2                " gerneral error in a DP call
        cntl_error             = 3                " error
        html_syntax_notcorrect = 4                " HTML data is invalid and check all the tags' syntax
        OTHERS                 = 5
    ).
    IF sy-subrc <> 0.
      MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
        WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
    ENDIF.

    lo_viewer->show_url(
      EXPORTING
        url                    = lv_url                  " URL
        in_place               = 'X'             " Is the document displayed in the GUI?
      EXCEPTIONS
        cntl_error             = 1                " Error in CFW Call
        cnht_error_not_allowed = 2                " Navigation outside R/3 is not allowed
        cnht_error_parameter   = 3                " Incorrect parameters
        dp_error_general       = 4                " Error in DP FM call
        OTHERS                 = 5
    ).
    IF sy-subrc <> 0.
      MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
        WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
    ENDIF.

    cl_gui_cfw=>flush(
      EXCEPTIONS
        cntl_system_error = 1                " cntl_system_error
        cntl_error        = 2                " cntl_error
        OTHERS            = 3
    ).

    IF sy-subrc <> 0.
      MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
        WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
    ENDIF.

  ENDMETHOD.

ENDCLASS.

AT SELECTION-SCREEN ON VALUE-REQUEST FOR p_file.
  p_file = NEW lcl_xml_display( )->get_file( ).

START-OF-SELECTION.

  TRY.
      DATA(lo_reader) = NEW lcl_xml_display( ).

      DATA(lv_xml_xstr) = lo_reader->upload_xml( iv_path = CONV string( p_file ) ).

      lo_reader->find_binary_object( iv_xstring = lv_xml_xstr ).

      CALL SCREEN 100.
    CATCH cx_static_check INTO DATA(lx_error).
      MESSAGE lx_error->get_text( ) TYPE 'E'.
  ENDTRY.

